APP_IMAGE=ghcr.io/ise-consult/hms-backend@sha256:replace-with-approved-digest

# Django
DJANGO_SETTINGS_MODULE=hms.settings.staging
DEBUG=False
APP_ENV=docker
SECRET_KEY=replace-with-a-strong-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5050
WS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5050
CORS_ALLOW_CREDENTIALS=False

# Database
POSTGRES_ENGINE=django.db.backends.postgresql
POSTGRES_DB=hms_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-database-password
POSTGRES_HOST=postgres.example.internal
POSTGRES_PORT=5432

# Celery & Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TIME_ZONE=Africa/Accra
CELERY_CONCURRENCY=4
CELERY_LOG_LEVEL=info
REDIS_HOST=redis://redis.example.internal:6379/0

# The production database and Redis are external to this Compose file.
APP_HOST_PORT=8000

# Base URL
BASE_URL=http://localhost:8000
DOMAIN=http://localhost:8000
PASS_RESET_DOMAIN=http://localhost:8000/login

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=2525
EMAIL_HOST_USER=apikey
EMAIL_USE_TLS=True
EMAIL_HOST_PASSWORD=your-sendgrid-password-here
SENDGRID_API_KEY=your-sendgrid-api-key-here
DEFAULT_FROM_EMAIL=info@yourdomain.com

APP_NAME=hms
ARKESEL_BASE_URL=https://sms.arkesel.com/api
ARKESEL_API_KEY=your-arkesel-api-key
ARKESEL_SENDER_ID=hms
BREVO_API_KEY=your-brevo-api-key
BREVO_FROM_EMAIL=info@yourdomain.com
BREVO_FROM_NAME=hms

# SMS
SMS_KEY=your-sms-key-here

# Object storage
USE_S3=False
AWS_ACCESS_KEY_ID=replace-with-aws-access-key
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-key
AWS_BUCKET_NAME=replace-with-bucket-name
AWS_S3_ENDPOINT_URL=

